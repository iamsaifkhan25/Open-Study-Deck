# Razorpay donations. Use Test Mode credentials locally; never put live values
# in this example or commit the copied `.env` file.
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=replace_with_a_separate_webhook_signing_secret
RAZORPAY_MAX_DONATION_CENTS=100000

# Optional payment-only allowlist. If omitted, ALLOWED_ORIGINS below is used.
# PAYMENT_ALLOWED_ORIGINS=http://localhost:5173,https://openstudydeck.com,https://www.openstudydeck.com

# Local Vite refuses rzp_live_ keys by default. Do not enable this for normal
# development; it exists only for deliberate owner-led live troubleshooting.
# ALLOW_LIVE_RAZORPAY_LOCAL=false

# Guest AI Generation (optional locally — only needed to exercise Guest
# Access via `npm run dev`, which mocks the Cloudflare Function using these
# same variables). See docs/CLOUDFLARE_GUEST_AI_SETUP.md for full setup.
GEMINI_API_KEY=replace_with_local_development_key
GEMINI_GUEST_MODEL=replace_with_supported_guest_model
TURNSTILE_SECRET_KEY=replace_with_turnstile_secret
TURNSTILE_SITE_KEY=replace_with_turnstile_site_key
RATE_LIMIT_SALT=replace_with_long_random_secret
GUEST_MODE_ENABLED=true
GUEST_DAILY_LIMIT=5
ALLOWED_ORIGINS=http://localhost:5173,https://openstudydeck.com,https://www.openstudydeck.com

# Optional. Overrides the mode-aware output-token budget (see
# shared/study-config.js OUTPUT_TOKEN_BUDGETS) for ALL guest generations.
# Not secret. Must be a safe integer between 256 and 16384 — any missing or
# out-of-range value falls back to the mode-aware default automatically.
# GEMINI_GUEST_MAX_OUTPUT_TOKENS=6144
