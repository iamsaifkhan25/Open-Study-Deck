{
  "name": "openstudydeck",
  "private": true,
  "version": "1.5.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:cf": "npx wrangler pages dev -- npm run dev",
    "build": "vite build",
    "build:functions": "wrangler pages functions build --outdir .wrangler/functions-build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "deploy:manual": "npx wrangler pages deploy ./dist --project-name openstudydeck --branch master"
  },
  "devDependencies": {
    "vite": "^8.2.2",
    "wrangler": "^4.125.0"
  }
}
